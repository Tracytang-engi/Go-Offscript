{
  "expo": {
    "name": "Go Off Script",
    "slug": "go-offscript",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.go-offscript.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Go Off Script needs access to your photo library so you can upload social screenshots for Nova to analyze your interests.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.go_offscript.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "1eab9474-dce5-4937-834e-52d95590f79d"
      }
    }
  }
}
