{
  "name": "@go-offscript/early-bird-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": { "./storage": "./src/storage.js", "./validation": "./src/validation.js" },
  "files": ["src"],
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "migrate": "node --env-file-if-exists=.env src/migrate.js",
    "test": "node --test test/*.test.js",
    "test:integration": "node --env-file-if-exists=.env --test test/integration.test.js"
  },
  "engines": { "node": ">=22" },
  "dependencies": { "express": "^5.2.1", "pg": "^8.20.0" }
}
